<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/landingFragment">

    <fragment
        android:id="@+id/landingFragment"
        android:name="com.example.hayatwallet.scenes.LandingFragment"
        android:label="fragment_landing"
        tools:layout="@layout/fragment_landing" >

    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.hayatwallet.scenes.LoginFragment"
            android:label="fragment_login"
        tools:layout="@layout/fragment_login" >



    </fragment>
    <action
        android:id="@+id/toHub"
        app:destination="@id/tabLayoutFragment"
        app:exitAnim="@anim/nav_default_exit_anim" />
    <action
        android:id="@+id/toCampaignDetails"
        app:destination="@id/campaignDetails"
        app:exitAnim="@anim/nav_default_exit_anim" />
    <action
        android:id="@+id/toLoginActivity"
        app:destination="@id/loginFragment"
        app:exitAnim="@anim/nav_default_exit_anim" />
    <fragment
        android:id="@+id/tabLayoutFragment"
        android:name="com.example.hayatwallet.scenes.TabLayoutFragment"
        android:label="fragment_tab_layout"
        tools:layout="@layout/fragment_tab_layout" />
    <fragment
        android:id="@+id/campaignDetails"
        android:name="com.example.hayatwallet.scenes.CampaignDetails"
        android:label="fragment_campaign_details"
        tools:layout="@layout/fragment_campaign_details" ><argument
        android:name="title"
        app:argType="string" />
        <argument
            android:name="imageUrl"
            app:argType="string" /></fragment>


</navigation>